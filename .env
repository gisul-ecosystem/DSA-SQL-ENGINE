# On Windows + Docker Desktop, HOST_SANDBOX_ROOT must be the Linux path
# that the Docker daemon sees. Docker Desktop maps C:\ -> /run/desktop/mnt/host/c/
HOST_SANDBOX_ROOT=/run/desktop/mnt/host/c/judge-sandbox

# Optional tuning (defaults shown)
WORKER_CONCURRENCY=8
DOCKER_RUN_CONCURRENCY=6
COMPILE_CONCURRENCY=3
EXECUTION_TIMEOUT_SECONDS=10
WARM_POOL_MAX_PER_IMAGE=50
WARM_CONTAINER_TTL_SECONDS=300
WORKER_LANGUAGES=python,javascript,c,java,kotlin,go,rust,typescript,cpp,csharp
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_SDK_DISABLED=true
